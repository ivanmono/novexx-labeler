{
  "name": "novexx-labeller-hmi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next-generation labeller HMI (PID Group / Mono) — functional prototype with dummy data",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "data:sync": "node scripts/extract-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "icons:sprite": "node scripts/build-sprite.mjs",
    "figma:capture": "node scripts/figma/capture.mjs test-results/figma",
    "figma:payload": "node scripts/figma/payload.mjs",
    "check": "npm run lint && npm run data:validate && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/figtree": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  }
}
